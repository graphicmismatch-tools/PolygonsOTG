{
  "name": "polygons-otg",
  "private": true,
  "version": "0.1.0",
  "description": "Low-to-medium poly 3D modelling toolkit for Android (touch + stylus)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "android:sync": "npm run build && cap sync android",
    "apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/three": "^0.170.0",
    "typescript": "5.6",
    "vite": "^6.4.5",
    "vitest": "^2.1.9"
  }
}
