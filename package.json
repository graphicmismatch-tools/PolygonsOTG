{
  "name": "polygons-otg",
  "private": true,
  "version": "0.1.0",
  "description": "Low-to-medium poly 3D modelling toolkit for Android (touch + stylus)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "android:sync": "npm run build && node scripts/sync-android.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "5.6",
    "vite": "^6.4.5",
    "vitest": "^2.1.9"
  }
}
